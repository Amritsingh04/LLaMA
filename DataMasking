def run_masking(change):
    text = input_text.value
    # Base LLaMA
    prompt = f"Mask all personal information (names, emails, phones, addresses, SSN) in the following text using placeholders [NAME], [EMAIL], [PHONE], [ADDRESS], [SSN]:\n{text}"
    base_masked = llama_generate(prompt)
    output_base.value = base_masked

    # Detect missed PII
    missed = detect_missed_pii(text, base_masked)
    missed_output.value = str(missed) if missed else "No PII missed"

    # LoRA-enhanced (simulated)
    lora_masked = base_masked
    # For demo, assume LoRA fixes all missed PII
    for label, match in missed:
        lora_masked = lora_masked.replace(match, f"[{label}]")
    output_lora.value = lora_masked

# Link run to input changes
input_text.observe(run_masking, names="value")

